/**
 * Wrangler configuration for the control-plane web app (Next.js via OpenNext).
 *
 * ADR-0016: one Cloudflare account, three environments. Staging and production
 * use strictly separate D1 databases, R2 buckets, queues, workflow bindings and
 * secrets. No real resource IDs are committed — placeholders below are filled in
 * per environment by the humans provisioning resources (docs/environments.md).
 *
 * Secrets (BETTER_AUTH_SECRET, …) are NEVER declared in this file; they are set
 * with `wrangler secret put <NAME> --env <env>` per docs/environments.md.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-factory-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Local development (`wrangler dev` / `opennextjs-cloudflare preview`) uses
  // local Miniflare resources by default — it must not connect to production
  // data. Local vars/secrets come from .dev.vars (see .dev.vars.example).
  "vars": {
    "APP_ENV": "development",
  },
  // Local-only D1: the zero database_id is a placeholder that Miniflare
  // ignores (it provisions a local SQLite file). Real IDs exist only in the
  // per-environment blocks below, filled in at provisioning time.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-factory-db-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "website-factory-assets-dev" }],
  // Local `next dev` has no cross-script workflow binding (it would require a
  // running orchestrator dev session); submissions then leave projects at
  // `created` and the workflow starter is skipped. Uncomment to test the full
  // pipeline locally alongside `wrangler dev` in workers/orchestrator.
  // "workflows": [
  //   {
  //     "binding": "PROJECT_PIPELINE",
  //     "name": "website-factory-project-pipeline-dev",
  //     "class_name": "ProjectPipeline",
  //     "script_name": "website-factory-orchestrator-dev"
  //   }
  // ],
  "env": {
    "staging": {
      "name": "website-factory-staging",
      // Served from workers.dev initially; custom domains are optional and
      // documented for later (docs/environments.md).
      "workers_dev": true,
      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://website-factory-staging.griffin-716.workers.dev",
        "ALLOWED_ORIGINS": "https://website-factory-staging.griffin-716.workers.dev",
      },
      // Provisioned 2026-07-30 (docs/environments.md). Committed database_id is
      // configuration, not a secret (committed-ID policy).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "website-factory-db-staging",
          "database_id": "d51b40db-64c5-456e-b2ff-deb580c9bc31",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      // R2 pending: the account has not enabled R2 yet; the binding is added
      // once website-factory-assets-staging exists. Uploads fail safely without it.
      "workflows": [
        {
          "binding": "PROJECT_PIPELINE",
          "name": "website-factory-project-pipeline-staging",
          "class_name": "ProjectPipeline",
          "script_name": "website-factory-orchestrator-staging",
        },
      ],
    },
    "production": {
      "name": "website-factory-production",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production",
      },
      // ---- M1+ binding placeholders (uncomment when resources are provisioned) ----
      // Production resources are provisioned ONLY via the explicit, human-confirmed
      // commands in docs/environments.md — never automatically.
      // "d1_databases": [
      //   {
      //     "binding": "DB",
      //     "database_name": "website-factory-db-production",
      //     "database_id": "<PRODUCTION_D1_DATABASE_ID — fill in at provisioning time>",
      //     "migrations_dir": "../../packages/db/migrations"
      //   }
      // ],
      // "r2_buckets": [
      //   { "binding": "ASSETS_BUCKET", "bucket_name": "website-factory-assets-production" }
      // ],
      // "queues": {
      //   "producers": [
      //     { "binding": "EVENTS_QUEUE", "queue": "website-factory-events-production" }
      //   ]
      // },
      // "workflows": [
      //   {
      //     "binding": "PROJECT_PIPELINE",
      //     "name": "website-factory-project-pipeline-production",
      //     "class_name": "ProjectPipeline",
      //     "script_name": "website-factory-orchestrator-production"
      //   }
      // ]
    },
  },
}
