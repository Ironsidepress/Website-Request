# Local development variables for apps/web.
# Copy to `.dev.vars` (gitignored) and fill in values. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=debug

# Public base URL of the local app (auth callbacks and email links).
APP_BASE_URL=http://localhost:3000

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Authentication secret for the auth layer (min 32 chars). Generate your own:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-your-own-value-min-32-chars>

# ADR-0015: initial administrator bootstrap. Optional — set only while
# bootstrapping the first administrator, then remove (docs/environments.md).
# INITIAL_ADMIN_EMAIL=admin@example.com
