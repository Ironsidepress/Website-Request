{
  "name": "@website-factory/web",
  "private": true,
  "version": "0.0.0",
  "description": "Control-plane web app: client portal, admin dashboard and API routes",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply website-factory-db-dev --local",
    "e2e": "pnpm db:migrate:local && playwright test"
  },
  "dependencies": {
    "@website-factory/core": "workspace:*",
    "@website-factory/db": "workspace:*",
    "@website-factory/schemas": "workspace:*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.1"
  }
}
